# 默认按文本处理，仓库内统一 LF
* text=auto eol=lf

# 生命周期脚本必须是 LF + 可执行（fnOS 侧直接 bash 调用）
cmd/* text eol=lf
cmd/main text eol=lf

# 脚本与配置
*.sh    text eol=lf
*.py    text eol=lf diff=python
*.js    text eol=lf diff=javascript
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf

# 图标是二进制，避免行尾转换与 diff 噪音
*.PNG   binary
*.png   binary
*.ico   binary

# 构建产物
*.fpk   binary
*.tgz   binary
